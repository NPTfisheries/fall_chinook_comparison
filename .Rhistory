snake_clean <- snake %>%
filter(estimatetype == "Escapement") %>%
select(spawningyear, tsaej) %>%
rename(year = spawningyear,
total = tsaej) %>%
mutate(pop = "snake")
deschutes_clean <- deschutes %>%
select(year, run_to_river) %>%
rename(total = run_to_river) %>%
mutate(pop = "deschutes")
hanford_clean <- hanford %>%
select(year, adults) %>%
rename(total = adults) %>%
mutate(pop = "hanford")
comp <- rbind(snake_clean, deschutes_clean, hanford_clean)
ggplot(comp, aes(x = year, y = total, group = pop)) +
geom_line(linewidth = 1, aes(color = pop)) +
plot_theme
comp %>%
group_by(pop) %>%
mutate(center = scale(total))
comp <- comp %>%
group_by(pop) %>%
mutate(center = scale(total))
ggplot(comp, aes(x = year, y = center, group = pop)) +
geom_line(linewidth = 1, aes(color = pop)) +
plot_theme
ggplot(comp, aes(x = year, y = center, group = pop)) +
geom_line(linewidth = 1, aes(color = pop)) +
plot_theme +
geom_hline(yintercept = 0, linetype = "dashed", linewidth = 1)
comp %>%
mutate(trt = if_else(year >= 1980 & year <= 1995, "pre",
if_else(year >= 2010 & year <= 2025, "post", NA)))
lmm_dat <- comp %>%
mutate(trt = if_else(year >= 1980 & year <= 1995, "pre",
if_else(year >= 2010 & year <= 2025, "post", NA))) %>%
filter(!(is.na(trt)))
lmm_dat
hist(lmm_dat$total)
hist(log(lmm_dat$total))
library(lme4)
lmm_fit <- lmer(total ~ pop*trt + (1|pop), data = lmm_dat)
lmm_fit
lmm_fit <- lmer(log(total) ~ pop*trt + (1|pop), data = lmm_dat)
lmm_fit <- lmer(log(total+1) ~ pop*trt + (1|pop), data = lmm_dat)
lmm_fit
summary(lmm_fit)
